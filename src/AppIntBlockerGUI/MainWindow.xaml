<Window x:Class="AppIntBlockerGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppIntBlockerGUI.ViewModels"
        xmlns:views="clr-namespace:AppIntBlockerGUI.Views"
        Title="AppIntBlocker" Width="980" Height="780" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Ink}"
        FontFamily="{StaticResource Font.Ui}" FontSize="16">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BlockViewModel}">
            <views:BlockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BlockedAppsViewModel}">
            <views:BlockedAppsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Everything but the dialog; disabled while a question is open so focus stays in the dialog. -->
        <Grid IsEnabled="{Binding IsDialogClosed}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Masthead: wordmark, the two pages, and Windows Firewall's own window. -->
            <Border MinHeight="58" Padding="24,0" Background="{DynamicResource Brush.Bg}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Wordmark}" Text="AppIntBlocker" VerticalAlignment="Center" Margin="0,0,28,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource Tab}" GroupName="Pages" Content="Block"
                                     IsChecked="{Binding ShowBlock, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource Tab}" GroupName="Pages" Content="Blocked apps" Margin="4,0,0,0"
                                     IsChecked="{Binding ShowBlockedApps, Mode=TwoWay}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Button.OutlineSmall}" Content="Open Windows Firewall"
                            Command="{Binding OpenFirewallCommand}" VerticalAlignment="Center"
                            ToolTip="Opens Windows Firewall with Advanced Security (wf.msc)" />
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- Footer: a line on top, the name and version at the start, the author's GitHub at the end. -->
            <Border Grid.Row="2" MinHeight="56" Padding="24,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Meta}" Text="{Binding Version}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.OutlineSmall}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding OpenGitHubCommand}" ToolTip="Opens github.com/bugragungoz"
                            AutomationProperties.Name="bugragungoz on GitHub">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.GitHub}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="bugragungoz" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Dialog: a surface sheet on a scrim; Escape or Cancel answers no, focus starts on Cancel. -->
        <Grid x:Name="DialogLayer" Visibility="{Binding IsDialogOpen, Converter={StaticResource Visible}}"
              IsVisibleChanged="OnDialogVisibleChanged">
            <Rectangle Fill="{DynamicResource Brush.Scrim}" />
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28"
                    Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1"
                    CornerRadius="14" Effect="{DynamicResource Shadow.Dialog}"
                    KeyboardNavigation.TabNavigation="Cycle" DataContext="{Binding Dialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H3}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Body}" Margin="0,12,0,0" FontSize="13" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                        <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                        <!-- The action goes last: a removal in the danger style, anything else as primary. -->
                        <Button Style="{StaticResource Button.Danger}" Content="{Binding ConfirmText}" Command="{Binding AcceptCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsDestructive, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}" Command="{Binding AcceptCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsSafe, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

<!-- Bugra design system, light theme: the colors of tokens.json version 3, copied exactly (rgba
     written as #AARRGGBB). Every color in the app comes from here; never write a hex value elsewhere. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Bg">#FFF6F3EE</Color>
    <Color x:Key="Color.Surface">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface2">#FFEBE7E0</Color>
    <Color x:Key="Color.Ink">#FF131110</Color>
    <Color x:Key="Color.Muted">#FF5F5850</Color>
    <Color x:Key="Color.Line">#1A131110</Color>
    <Color x:Key="Color.LineStrong">#33131110</Color>
    <Color x:Key="Color.BorderControl">#FF7A7369</Color>
    <Color x:Key="Color.Accent">#FF3DDC84</Color>
    <Color x:Key="Color.AccentHover">#FF2FC274</Color>
    <Color x:Key="Color.AccentQuiet">#1F086B37</Color>
    <Color x:Key="Color.AccentInk">#FF086B37</Color>
    <Color x:Key="Color.OnAccent">#FF131110</Color>
    <Color x:Key="Color.CodeBg">#FFEFEBE4</Color>
    <Color x:Key="Color.CodeMuted">#FF6B645B</Color>
    <Color x:Key="Color.Ok">#FF1A6E33</Color>
    <Color x:Key="Color.Warn">#FFA63A25</Color>
    <Color x:Key="Color.Info">#FF1A5A94</Color>
    <Color x:Key="Color.Scrim">#66131110</Color>
    <Color x:Key="Color.DisabledInk">#61131110</Color>
    <Color x:Key="Color.DisabledFill">#1F131110</Color>
    <Color x:Key="Color.Selection">#38086B37</Color>
    <Color x:Key="Color.FocusRing">#FF086B37</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="Brush.BorderControl" Color="{StaticResource Color.BorderControl}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentQuiet" Color="{StaticResource Color.AccentQuiet}" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{StaticResource Color.AccentInk}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.CodeBg" Color="{StaticResource Color.CodeBg}" />
    <SolidColorBrush x:Key="Brush.CodeMuted" Color="{StaticResource Color.CodeMuted}" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.DisabledInk" Color="{StaticResource Color.DisabledInk}" />
    <SolidColorBrush x:Key="Brush.DisabledFill" Color="{StaticResource Color.DisabledFill}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />

    <!-- shadow-menu (0 18px 44px) and shadow-dialog (0 24px 64px): only floating layers get one. -->
    <DropShadowEffect x:Key="Shadow.Menu" Direction="270" ShadowDepth="18" BlurRadius="44" Color="#FF131110" Opacity="0.16" />
    <DropShadowEffect x:Key="Shadow.Dialog" Direction="270" ShadowDepth="24" BlurRadius="64" Color="#FF131110" Opacity="0.2" />
</ResourceDictionary>

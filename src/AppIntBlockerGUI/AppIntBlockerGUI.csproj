<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AppIntBlockerGUI</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>bugragungoz</Authors>
    <Product>AppIntBlocker</Product>
    <Description>Blocks an application's internet access with Windows Firewall rules.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppIntBlocker.Core\AppIntBlocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

<UserControl x:Class="AppIntBlockerGUI.Views.BlockedAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,36,40,36" MaxWidth="900">
            <TextBlock Style="{StaticResource Text.H2}" Text="Blocked applications" />
            <TextBlock Style="{StaticResource Text.Lead}" Margin="0,8,0,0"
                       Text="Rules added by AppIntBlocker or its PowerShell script. Removing an application's rules gives it its internet access back." />

            <Grid Margin="0,28,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.OutlineSmall}" Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource Button.OutlineSmall}" Content="Back up rules" Command="{Binding BackupCommand}" Margin="8,0,0,0"
                            ToolTip="Saves every Windows Firewall rule to a file in Documents\AppIntBlocker\Backups" />
                </StackPanel>
                <Button Style="{StaticResource Button.DangerSmall}" Content="Remove all" Command="{Binding RemoveAllCommand}" HorizontalAlignment="Right"
                        Visibility="{Binding HasApps, Converter={StaticResource Visible}}" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Status}" Tag="{Binding StatusKind}" Text="{Binding StatusMessage}" Margin="0,12,0,0" />

            <!-- One row per application, divided by hairlines -->
            <Border Margin="0,16,0,0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                    CornerRadius="14" Visibility="{Binding HasApps, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Padding="20,16" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Small}" Text="{Binding Summary}" Margin="0,2,0,0" />
                                        <TextBlock Style="{StaticResource Text.Small}" Text="{Binding FilesPreview}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource Button.DangerSmall}" Content="Remove" VerticalAlignment="Center" Margin="16,0,0,0"
                                            AutomationProperties.Name="{Binding RemoveLabel}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- No rule above the first row: the box's own border is there. -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Empty state: says what is missing and offers the next action -->
            <Border Margin="0,16,0,0" Padding="28" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1" CornerRadius="14" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H3}" Text="No application is blocked" />
                    <TextBlock Style="{StaticResource Text.Small}" Text="Block one on the Block page and its rules show up here." Margin="0,8,0,0" />
                    <Button Content="Block an application" Command="{Binding GoToBlockCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

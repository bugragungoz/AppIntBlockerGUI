<UserControl x:Class="AppIntBlockerGUI.Views.BlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,36,40,36" MaxWidth="900">
            <TextBlock Style="{StaticResource Text.H2}" Text="Block an application" />
            <TextBlock Style="{StaticResource Text.Lead}" Margin="0,8,0,0"
                       Text="Choose the application's folder. Every .exe in it gets a Windows Firewall rule that blocks its internet access." />

            <!-- Folder -->
            <Label Content="_Folder" Target="{Binding ElementName=FolderBox}" Margin="0,32,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                         LostKeyboardFocus="OnFolderLostFocus">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ScanCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseCommand}" Margin="12,0,0,0" />
            </Grid>
            <TextBlock Style="{StaticResource Text.Status}" Tag="{Binding FolderMessageKind}" Text="{Binding FolderMessage}" Margin="0,8,0,0" />

            <!-- Files found in the folder -->
            <Grid Margin="0,24,0,0" Visibility="{Binding HasFiles, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Label}" Text="Files to block" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Text="{Binding SelectionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.OutlineSmall}" Content="Select all" Command="{Binding SelectAllCommand}" />
                    <Button Style="{StaticResource Button.OutlineSmall}" Content="Select none" Command="{Binding SelectNoneCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <Border Margin="0,12,0,0" Padding="16,6" MaxHeight="264" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="14"
                    Visibility="{Binding HasFiles, Converter={StaticResource Visible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" PreviewMouseWheel="OnInnerWheel">
                    <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A TextBlock, so an underscore in a file name is shown, not read as an access key. -->
                                <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding RelativePath}">
                                    <TextBlock Text="{Binding RelativePath}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Name -->
            <Label Content="_Name" Target="{Binding ElementName=NameBox}" Margin="0,24,0,8" />
            <TextBox x:Name="NameBox" Text="{Binding ApplicationName, UpdateSourceTrigger=PropertyChanged}" MaxWidth="440" HorizontalAlignment="Left" Width="440" />
            <TextBlock Style="{StaticResource Text.Status}" Tag="{Binding NameMessageKind}" Text="{Binding NameMessage}" Margin="0,8,0,0" />

            <!-- Backup -->
            <CheckBox Style="{StaticResource Switch}" Content="Back up the firewall rules first" IsChecked="{Binding BackUpFirst}" Margin="0,20,0,0"
                      HorizontalAlignment="Left" />
            <TextBlock Style="{StaticResource Text.Small}" Margin="56,0,0,0">
                <Run Text="Saved in" />
                <Run Text="{Binding BackupFolder, Mode=OneWay}" />
            </TextBlock>

            <!-- The one primary action, and its result next to it -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Button.Primary}" Content="Block" MinWidth="120" Command="{Binding BlockCommand}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Status}" Tag="{Binding ResultKind}" Text="{Binding ResultMessage}"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <!-- Activity -->
            <TextBlock Style="{StaticResource Text.H3}" Text="Activity" Margin="0,40,0,0" />
            <TextBox x:Name="ActivityBox" Style="{StaticResource TextBox.Code}" Text="{Binding Log.Text, Mode=OneWay}" Height="168" Margin="0,12,0,0"
                     TextChanged="OnActivityChanged" PreviewMouseWheel="OnInnerWheel" AutomationProperties.Name="Activity log" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
